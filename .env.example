# Supabase接続設定
# .env にコピーして実際の値を設定してください（.env はgit管理外です）
# Project Settings > API から取得できます: https://supabase.com/dashboard/project/_/settings/api

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# RevenueCat の Public SDK キー(RevenueCat > Project settings > API keys から取得)
# iOS は appl_ で始まるキー。Android は goog_ で始まるキー(未設定のうちは、Androidでは課金を無効にします)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
